# Lancador de compilacao (BS_MSVC_DEPS_JSON): dependencias de cabecalho do MSVC independentes de
# idioma e de pagina de codigo. O compilador grava as dependencias em JSON
# (/sourceDependencies <depfile>.json); este script roda o compilador e converte o JSON para o
# formato de depfile que o ninja le (deps = gcc). Nao ha texto traduzido no caminho (o
# /showIncludes depende do idioma do MSVC e da pagina de codigo do terminal: STATUS.md, N2a).
# Uso (CMAKE_<LANG>_COMPILER_LAUNCHER): cmake -P msvc_srcdeps.cmake -- <compilador> <argumentos>
set(cmd "")
set(seen FALSE)
set(json "")
set(obj "")
set(next_is_json FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE 1 ${last})
  set(a "${CMAKE_ARGV${i}}")
  if(NOT seen)
    if(a STREQUAL "--")
      set(seen TRUE)
    endif()
    continue()
  endif()
  # listas do CMake: uma barra invertida no fim escaparia o separador ";" e juntaria dois
  # argumentos (ex.: /Fd<pasta>\ /FS no build debug). O cl aceita "/" como separador de pasta.
  if(a MATCHES "\\\\$")
    string(REGEX REPLACE "\\\\$" "/" a "${a}")
  endif()
  if(a MATCHES ";")
    message(FATAL_ERROR "msvc_srcdeps: argumento com ';' nao suportado: ${a}")
  endif()
  list(APPEND cmd "${a}")
  if(next_is_json)
    set(json "${a}")
    set(next_is_json FALSE)
  elseif(a STREQUAL "/sourceDependencies" OR a STREQUAL "-sourceDependencies")
    set(next_is_json TRUE)
  elseif(a MATCHES "^[/-]Fo(.+)$")
    set(obj "${CMAKE_MATCH_1}")
  endif()
endforeach()
if(NOT cmd)
  message(FATAL_ERROR "msvc_srcdeps: nenhum comando depois de --")
endif()
execute_process(COMMAND ${cmd} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  # o compilador ja imprimiu os erros; so propaga a falha (FATAL_ERROR: codigo nao zero, CMake 3.25+)
  message(FATAL_ERROR "msvc_srcdeps: o compilador falhou (codigo ${rc})")
endif()
if(json STREQUAL "")
  return()  # unidade sem /sourceDependencies (outro tipo de arquivo)
endif()
if(NOT json MATCHES "\\.json$" OR obj STREQUAL "")
  message(FATAL_ERROR "msvc_srcdeps: esperado /sourceDependencies <depfile>.json e /Fo<objeto>")
endif()
file(READ "${json}" data)
string(JSON n ERROR_VARIABLE err LENGTH "${data}" Data Includes)
if(err)
  message(FATAL_ERROR "msvc_srcdeps: JSON de dependencias invalido (${json}): ${err}")
endif()
# depfile no formato make lido pelo ninja (depfile_parser): barras normais; espaco vira "\ ",
# "#" vira "\#" e "$" vira "$$" (revisao Codex 2026-10-15)
function(depfile_escape in out)
  string(REPLACE "\\" "/" v "${in}")
  string(REPLACE "$" "$$" v "${v}")
  string(REPLACE "#" "\\#" v "${v}")
  string(REPLACE " " "\\ " v "${v}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()
depfile_escape("${obj}" target)
set(out "${target}:")
if(n GREATER 0)
  math(EXPR last "${n} - 1")
  foreach(k RANGE ${last})
    string(JSON inc GET "${data}" Data Includes ${k})
    depfile_escape("${inc}" inc)
    string(APPEND out " \\\n  ${inc}")
  endforeach()
endif()
string(REGEX REPLACE "\\.json$" "" depfile "${json}")
file(WRITE "${depfile}" "${out}\n")
file(REMOVE "${json}")
