# N0: o executavel do jogo nao contem a leitura de CDI (bs_runtime_cdi). Le o mapa do linker
# do bluestinger.exe e falha se algum simbolo dela aparece. Uso: cmake -DMAP=<map> -P ...
if(NOT EXISTS "${MAP}")
  message(FATAL_ERROR "mapa do linker ausente: ${MAP} (compile o alvo bluestinger)")
endif()
file(READ "${MAP}" text)
set(bad "")
foreach(sym CdiImage open_disc_image boot_read_disc ImageSource cdi_image disc_boot image_source)
  string(FIND "${text}" "${sym}" pos)
  if(NOT pos EQUAL -1)
    list(APPEND bad "${sym}")
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "o produto contem a leitura de CDI: ${bad}")
endif()
string(FIND "${text}" "boot_read_data" ok)
if(ok EQUAL -1)
  message(FATAL_ERROR "mapa sem boot_read_data: mapa de outro executavel?")
endif()
message(STATUS "produto sem leitura de CDI")
