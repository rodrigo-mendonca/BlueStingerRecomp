# N8.2: catraca dos papeis do executavel do jogo (docs/N8-2-SEPARACAO.md).
#  1. o grafo do runtime (runtime_papeis.txt, gerado pelo CMake) tem os papeis do produto e, conforme a configuracao,
#     o de validacao ou os stubs;
#  2. o mapa do linker do bluestinger.exe confirma os objetos: sem BS_VALIDACAO, nenhum objeto exclusivo de validacao
#     (hw_probe, cycle_noise, cri_diag) e o stub presente; com ela, o contrario. O extrator e o leitor de CDI nunca;
#  3. o comportamento: o exe sem BS_VALIDACAO recusa BS_CICLOS_RUIDO (saida 2 com a mensagem); com ela, aceita.
#  4. o manifesto completo (runtime_manifesto.tsv: papel e fonte de cada objeto, das listas dos alvos): todo objeto dos
#     papeis da configuracao esta no mapa, salvo os que nada referencia (lista fechada abaixo, com o motivo); nenhum
#     objeto do papel ausente; o mapa nao e anterior ao executavel (revisao Codex 2026-10-26)
#  5. N8.3 (docs/N8-3-BOOT.md): o produto nao liga o modelo HLE do sistema (bios, flashrom, gdrom, data_source) e recusa
#     o que dependia dele (--arquivos legado, --flash, --sistema hle, BS_GDROM_TIMING: saida 2 com a mensagem); a
#     validacao liga o modelo (papel hle) e o aceita
# Uso: cmake -DPAPEIS=<runtime_papeis.txt> -DMANIFESTO=<runtime_manifesto.tsv> -DMAP=<map> -DEXE=<exe> -DVALIDACAO=ON|OFF
#            -P check_papeis.cmake
foreach(v PAPEIS MANIFESTO MAP EXE VALIDACAO)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "defina ${v}")
  endif()
endforeach()
file(STRINGS "${PAPEIS}" papeis)
set(papeis_produto aot nativo simulacao estavel diagnostico)
if(VALIDACAO)
  list(APPEND papeis_produto hle)
elseif("hle" IN_LIST papeis)
  message(FATAL_ERROR "papel hle (modelo do BIOS, GD-ROM e flash) no produto: ${papeis}")
endif()
foreach(p ${papeis_produto})
  if(NOT p IN_LIST papeis)
    message(FATAL_ERROR "papel ${p} ausente do runtime: ${papeis}")
  endif()
endforeach()
if(VALIDACAO)
  set(esperado validacao)
  set(proibido validacao_stubs)
else()
  set(esperado validacao_stubs)
  set(proibido validacao)
endif()
if(NOT esperado IN_LIST papeis OR proibido IN_LIST papeis)
  message(FATAL_ERROR "papeis do runtime (${papeis}) nao batem com BS_VALIDACAO=${VALIDACAO}")
endif()

if(NOT EXISTS "${MAP}")
  message(FATAL_ERROR "mapa do linker ausente: ${MAP}")
endif()
file(READ "${MAP}" text)
macro(tem obj out)
  string(FIND "${text}" "${obj}" _pos)
  if(_pos EQUAL -1)
    set(${out} FALSE)
  else()
    set(${out} TRUE)
  endif()
endmacro()
set(bad "")
# N8.7: a referencia grafica do caminho do TA (rasterizador sobre o TA, texels da VRAM, conversor YUV) so na validacao
foreach(obj hw_probe.cpp.obj gfx_probe.cpp.obj cycle_noise.cpp.obj cri_diag.cpp.obj pvr_render_ta.cpp.obj pvr_texel.cpp.obj ta_yuv.cpp.obj)
  tem(${obj} ha)
  if(VALIDACAO AND NOT ha)
    list(APPEND bad "${obj} ausente do build de validacao")
  elseif(NOT VALIDACAO AND ha)
    list(APPEND bad "${obj} no produto")
  endif()
endforeach()
# N8.7: no produto, nenhum simbolo da decodificacao de texels da VRAM, do rasterizador do TA ou do conversor YUV; o
# renderizador em software sobre a IR (o recuo permanente do Vulkan) tem de estar la
foreach(sym "?pvr_texel@bs@@" "?pvr_render_ta@bs@@" "?pvr_render_triangles@bs@@" "yuvConvert" "VramTexels")
  tem("${sym}" ha)
  if(NOT VALIDACAO AND ha)
    list(APPEND bad "simbolo ${sym} (referencia grafica do caminho do TA) no produto")
  endif()
endforeach()
foreach(obj soft_raster.cpp.obj soft_device.cpp.obj)
  tem(${obj} ha)
  if(NOT ha)
    list(APPEND bad "${obj} (o renderizador em software sobre a IR) ausente")
  endif()
endforeach()
# N8.7 (docs/N8-7-KAMUI.md, incremento 2): as listas do Kamui vao direto para a IR pelo ListSink; no produto, nem o
# decodificador do legado (Parser, pvr_decode_legacy) nem a FIFO de poligonos do legado (polygonFifo)
foreach(sym "?pvr_decode_legacy@bs@@" "@Parser@" "polygonFifo@")
  tem("${sym}" ha)
  if(NOT VALIDACAO AND ha)
    list(APPEND bad "simbolo ${sym} (decodificador/FIFO do legado) no produto")
  elseif(VALIDACAO AND NOT ha)
    list(APPEND bad "simbolo ${sym} (a referencia do ListSink) ausente da validacao")
  endif()
endforeach()
# N8.7 3a: no produto, os registradores graficos sao o FrameState nativo (system/graphics_bus); o banco do legado
# (pvr_regs) so na validacao, onde e a referencia e o FrameState roda em sombra
tem(pvr_regs.cpp.obj ha)
if(NOT VALIDACAO AND ha)
  list(APPEND bad "pvr_regs.cpp.obj (o banco de registradores do legado) no produto")
elseif(VALIDACAO AND NOT ha)
  list(APPEND bad "pvr_regs.cpp.obj (a referencia do FrameState) ausente da validacao")
endif()
tem(graphics_bus.cpp.obj ha)
if(NOT VALIDACAO AND NOT ha)
  list(APPEND bad "graphics_bus.cpp.obj (o FrameState do produto) ausente")
elseif(VALIDACAO AND ha)
  list(APPEND bad "graphics_bus.cpp.obj na validacao (o FrameState roda em sombra no banco do legado)")
endif()
foreach(sym "list_sink.cpp.obj" "?feed@ListSink@kamui@" "frame_state.cpp.obj" "?write@FrameState@kamui@")
  tem("${sym}" ha)
  if(NOT ha)
    list(APPEND bad "${sym} (o ListSink nativo) ausente")
  endif()
endforeach()
tem(validacao_stubs.cpp.obj ha)
if(VALIDACAO AND ha)
  list(APPEND bad "stubs no build de validacao")
elseif(NOT VALIDACAO AND NOT ha)
  list(APPEND bad "stubs ausentes do produto")
endif()
foreach(obj bios.cpp.obj flashrom.cpp.obj gdrom.cpp.obj data_source.cpp.obj maple.cpp.obj aica_regs.cpp.obj)  # N8.3/N8.4/N8.6: modelos
  tem(${obj} ha)
  if(VALIDACAO AND NOT ha)
    list(APPEND bad "${obj} ausente do build de validacao")
  elseif(NOT VALIDACAO AND ha)
    list(APPEND bad "${obj} (modelo HLE do sistema) no produto")
  endif()
endforeach()
foreach(obj cdi_image.cpp.obj extract.cpp.obj image_source.cpp.obj disc_boot.cpp.obj)
  tem(${obj} ha)
  if(ha)
    list(APPEND bad "${obj} no executavel do jogo")
  endif()
endforeach()
foreach(obj runtime_data.cpp.obj irq_bridge.cpp.obj tmu_logical.cpp.obj sys_logical.cpp.obj syscall_service.cpp.obj maple_bus.cpp.obj sound_bus.cpp.obj time_legacy.cpp.obj event_trace.cpp.obj)
  tem(${obj} ha)
  if(NOT ha)
    list(APPEND bad "${obj} ausente (mapa de outro executavel?)")
  endif()
endforeach()
# o mapa e do executavel conferido (gravado no mesmo link)
file(TIMESTAMP "${MAP}" tmap "%s" UTC)
file(TIMESTAMP "${EXE}" texe "%s" UTC)
math(EXPR atraso "${texe} - ${tmap}")
if(atraso GREATER 5)
  list(APPEND bad "mapa ${atraso} s mais antigo que o executavel (de outro link)")
endif()
# manifesto completo
set(sem_referencia snapshot.cpp)  # snapshot: diagnostico sem chamador no executavel do jogo (so testes); o linker nao o puxa
file(STRINGS "${MANIFESTO}" linhas)
set(n 0)
foreach(l ${linhas})
  string(REPLACE "	" ";" campos "${l}")
  list(GET campos 0 papel)
  list(GET campos 1 fonte)
  get_filename_component(nome "${fonte}" NAME)
  if(NOT papel IN_LIST papeis)
    list(APPEND bad "manifesto com o papel ${papel} fora da configuracao")
  endif()
  tem(${nome}.obj ha)
  if(NOT ha AND NOT nome IN_LIST sem_referencia)
    list(APPEND bad "${papel}/${nome} ausente do mapa")
  endif()
  math(EXPR n "${n} + 1")
endforeach()
# contagem exata (revisao Codex N8.3): um objeto novo de simulacao ou de validacao nao passa sem atualizar a catraca
if(VALIDACAO)
  set(n_esperado 47)  # N8.7: + pvr_render_ta, pvr_texel, ta_yuv, gfx_probe (fase 0)
else()
  set(n_esperado 35)
endif()
if(NOT n EQUAL n_esperado)
  list(APPEND bad "manifesto com ${n} objetos (esperado ${n_esperado}: atualize a catraca e docs/N8-3-BOOT.md)")
endif()
if(bad)
  message(FATAL_ERROR "mapa do linker: ${bad}")
endif()

# comportamento: --version com BS_CICLOS_RUIDO
set(ENV{BS_CICLOS_RUIDO} "1")
execute_process(COMMAND "${EXE}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
unset(ENV{BS_CICLOS_RUIDO})
if(VALIDACAO)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "o build de validacao recusou BS_CICLOS_RUIDO (rc=${rc}): ${err}")
  endif()
else()
  string(FIND "${err}" "so existe no build de validacao" msg)
  if(NOT rc EQUAL 2 OR msg EQUAL -1)
    message(FATAL_ERROR "o produto aceitou BS_CICLOS_RUIDO (rc=${rc}): ${out}${err}")
  endif()
endif()
# N8.3: o que dependia do modelo HLE do sistema
macro(roda_versao rotulo)
  execute_process(COMMAND "${EXE}" --version ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(VALIDACAO)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "o build de validacao recusou ${rotulo} (rc=${rc}): ${err}")
    endif()
  else()
    string(FIND "${err}" "so existe no build de validacao" msg)
    if(NOT rc EQUAL 2 OR msg EQUAL -1)
      message(FATAL_ERROR "o produto aceitou ${rotulo} (rc=${rc}): ${out}${err}")
    endif()
  endif()
endmacro()
roda_versao("--arquivos legado" --arquivos legado)
roda_versao("--flash" --flash nvmem.bin)
roda_versao("--sistema hle" --sistema hle)
# N8.4: o modelo do Maple (controle e VMU no barramento) e os diagnosticos dele
roda_versao("--controles legado" --controles legado)
roda_versao("--saves legado" --saves legado)
foreach(v BS_MAPLE_PORTS BS_MAPLE_FUNCAO BS_MAPLE_DEBUG BS_PAD_MUTACAO BS_PAD_LEITURAS)
  set(ENV{${v}} "1")
  roda_versao("${v}")
  unset(ENV{${v}})
endforeach()
set(ENV{BS_PAD_NATIVO_MUTACAO} "maple")
roda_versao("BS_PAD_NATIVO_MUTACAO=maple")
unset(ENV{BS_PAD_NATIVO_MUTACAO})
# N8.5: o filme legado (Sofdec e o conversor YUV)
roda_versao("--video legado" --video legado)
# N8.6: o audio legado e o modelo da AICA
roda_versao("--audio legado" --audio legado)
roda_versao("--audio-musica legado" --audio-musica legado)
roda_versao("--audio-efeitos legado" --audio-efeitos legado)
roda_versao("--audio-falas legado" --audio-falas legado)
set(ENV{BS_AUDIO} "legado")
roda_versao("BS_AUDIO=legado")
unset(ENV{BS_AUDIO})
foreach(v BS_AICA_TRACE BS_AICA_LOG BS_AICA_MUTACAO BS_AICA_DUMP_AT BS_AICA_LOG_TUDO)
  set(ENV{${v}} "1")
  roda_versao("${v}")
  unset(ENV{${v}})
endforeach()
foreach(v BS_RENDER_IR BS_RENDER_IR_BMP)  # N8.7: os modos que comparam com o caminho do TA
  set(ENV{${v}} "conferir")
  roda_versao("${v}")
  unset(ENV{${v}})
endforeach()
set(ENV{BS_GDROM_TIMING} "reios")
roda_versao("BS_GDROM_TIMING")
unset(ENV{BS_GDROM_TIMING})
execute_process(COMMAND "${EXE}" --version --sistema nativo RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "--sistema nativo recusado (rc=${rc}): ${err}")
endif()
message(STATUS "papeis: ${papeis}; BS_VALIDACAO=${VALIDACAO}; ${n} objetos do manifesto no mapa; comportamento conferido")
