# --- NUNCA versionar dados do jogo ---
/ISO/
*.cdi
*.gdi
*.chd
*.iso
*.bin
*.raw
*.img
*.mds
*.mdf
/game-data/
/saves/
# codigo gerado a partir do jogo
/generated/
/analysis/
# BIOS / flash
dc_boot*
dc_flash*
# build
/build/
/out/
.vs/
.vscode/
*.user
CMakeUserPresets.json
# logs e capturas
/logs/
*.log
*.trace
# revisoes do Codex (podem citar disassembly do jogo)
/reviews/
# snapshots de estado (memoria do jogo) para testes diferenciais
/snapshots/
__pycache__/
# distribuicoes locais (binarios derivados da copia do usuario)
/dist/
# legendas transcritas e traduzidas (texto derivado das falas do jogo): so locais, geradas por tools/dev/legendas;
# o Builder as instala a partir desta pasta (ver mods-padrao/README.md). Nao versionar nem publicar.
/mods-padrao/*/
/tools/dev/legendas/revisoes.*.tsv
/tools/dev/legendas/traducao.*.tsv
/tools/dev/legendas/pendentes.*.tsv
